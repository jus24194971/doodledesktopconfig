{
  "name": "doodledesktopconfig",
  "version": "0.1.0",
  "description": "Desktop configurator for Doodle Labs Mesh Rider radios",
  "main": "./out/main/index.js",
  "author": "jus24194971",
  "license": "MIT",
  "homepage": "https://github.com/jus24194971/doodledesktopconfig",
  "repository": {
    "type": "git",
    "url": "https://github.com/jus24194971/doodledesktopconfig.git"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.ui.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "icon": "python build/make-icon.py",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:linux": "npm run build && electron-builder --linux --publish never",
    "pack:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
